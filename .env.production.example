# Секрет для подписи сессионных cookie. Сгенерируйте: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Публичный адрес сайта (нужен для robots.txt и sitemap.xml)
SITE_URL=https://ratemusic.space

# Почта. resend — API с проверенным доменом; smtp — обычный ящик (пароль приложения).
# Без ключа письма печатаются в лог, а регистрация идёт без подтверждения.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="Rate <no-reply@ratemusic.space>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Почта администратора: аккаунт с этим e-mail получает права админа при регистрации и при входе
ADMIN_EMAIL=you@example.com

# Контакт для жалоб на копирайт, показывается в правилах и политике
CONTACT_EMAIL=you@example.com

# Лимиты загрузок
UPLOAD_LIMIT_TRACKS=100
UPLOAD_LIMIT_BYTES=2147483648
MIN_FREE_BYTES=1073741824

# Push-уведомления. Сгенерируйте ключи: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@ratemusic.space