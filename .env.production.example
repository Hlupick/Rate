# Секрет для подписи сессионных cookie. Сгенерируйте: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Публичный адрес сайта (нужен для robots.txt и sitemap.xml)
SITE_URL=https://monah.duckdns.org

# Почта администратора: аккаунт с этим e-mail получает права админа при регистрации и при входе
ADMIN_EMAIL=you@example.com

# Контакт для жалоб на копирайт, показывается в правилах и политике
CONTACT_EMAIL=you@example.com

# Импорт плейлистов Spotify по ссылке (необязательно).
# Создайте приложение: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Лимиты загрузок
UPLOAD_LIMIT_TRACKS=100
UPLOAD_LIMIT_BYTES=2147483648
MIN_FREE_BYTES=1073741824
